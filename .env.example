# ==============================================================================
# Scratch AI Chatbot - Environment Configuration Example
# ==============================================================================

# Insert your Scratch account username here (case-sensitive)
# Note: Your account needs "Scratcher" status on scratch.mit.edu to use cloud variables.
SCRATCH_USERNAME=your_scratch_username_here

# Insert your Scratch account password here
SCRATCH_PASSWORD=your_scratch_password_here

# Insert your Scratch project ID here (the numbers from your project's URL)
# For example, if your URL is https://scratch.mit.edu/projects/123456789/, the ID is 123456789
SCRATCH_PROJECT_ID=123456789

# Insert your Groq API key here (get one for free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# The AI model to use (default: openai/gpt-oss-120b)
# Other fast alternatives: qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Port for optional cloud health check server (default: 8080)
PORT=8080
